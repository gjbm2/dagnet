"""Logical tests for primitive-to-operator constructors."""

from __future__ import annotations

import unittest

import numpy as np

from primitive_operator_supply_candidate import (
    PrimitiveDrawSurface,
    PrimitiveEvidenceSurface,
    PrimitiveModelSurface,
    SourceDayPrimitiveEvidenceSurface,
    deterministic_draw_model_primitive_operators,
    deterministic_model_primitive_operator,
    draw_model_primitive_operators,
    evidence_primitive_operator,
    model_primitive_operator,
    nonlatent_model_primitive_operator,
    operators_for_path,
    source_day_evidence_primitive_operator,
)
from span_operator_supply_candidate import make_span_input
from span_readout_candidate import evaluate_span_readout


class PrimitiveOperatorSupplyCandidateTests(unittest.TestCase):
    def test_model_primitive_compiles_p_times_latency_increments(self) -> None:
        op = model_primitive_operator(
            PrimitiveModelSurface(
                edge_id="A-B",
                p=0.5,
                conditional_cdf=(0.0, 0.25, 1.0),
            ),
            days=5,
        )

        self.assertAlmostEqual(op.value[0, 1], 0.125)
        self.assertAlmostEqual(op.value[0, 2], 0.375)

    def test_nonlatent_model_primitive_is_delta_zero(self) -> None:
        op = nonlatent_model_primitive_operator("A-B", p=0.3, days=4)

        self.assertAlmostEqual(op.value[0, 0], 0.3)
        self.assertAlmostEqual(op.value[1, 1], 0.3)
        self.assertAlmostEqual(op.value[0, 1], 0.0)

    def test_deterministic_model_primitive_is_delta_at_shift(self) -> None:
        op = deterministic_model_primitive_operator(
            "A-B",
            p=0.3,
            shift_days=2,
            days=5,
        )

        self.assertAlmostEqual(op.value[0, 0], 0.0)
        self.assertAlmostEqual(op.value[0, 2], 0.3)
        self.assertAlmostEqual(op.value[1, 3], 0.3)

    def test_evidence_primitive_compiles_nk_curve_to_increments(self) -> None:
        op = evidence_primitive_operator(
            PrimitiveEvidenceSurface(
                edge_id="X-Y",
                n_by_age=(100.0, 100.0, 100.0),
                k_by_age=(0.0, 10.0, 25.0),
            ),
            days=5,
        )

        spec = make_span_input(
            cohort_ids=("C0",),
            root_days=(0,),
            root_counts=(200.0,),
            root_support_values=(1.0,),
            operators=(op,),
            days=5,
            max_tau=2,
        )
        surface = evaluate_span_readout(spec)

        self.assertAlmostEqual(surface.mass_at("C0", 1), 20.0)
        self.assertAlmostEqual(surface.mass_at("C0", 2), 50.0)

    def test_source_day_evidence_primitive_preserves_source_day_rows(self) -> None:
        op = source_day_evidence_primitive_operator(
            SourceDayPrimitiveEvidenceSurface(
                edge_id="X-Y",
                source_days=(0, 1),
                n_by_source_age=np.asarray(
                    [
                        [100.0, 100.0],
                        [100.0, 100.0],
                    ]
                ),
                k_by_source_age=np.asarray(
                    [
                        [0.0, 10.0],
                        [0.0, 40.0],
                    ]
                ),
            ),
            days=5,
        )

        spec = make_span_input(
            cohort_ids=("C0", "C1"),
            root_days=(0, 1),
            root_counts=(100.0, 100.0),
            root_support_values=(1.0, 1.0),
            operators=(op,),
            days=5,
            max_tau=1,
        )
        surface = evaluate_span_readout(spec)

        self.assertAlmostEqual(surface.mass_at("C0", 1), 10.0)
        self.assertAlmostEqual(surface.mass_at("C1", 1), 40.0)

    def test_draw_model_primitives_compile_one_operator_per_draw(self) -> None:
        ops = draw_model_primitive_operators(
            PrimitiveDrawSurface(
                edge_id="A-B",
                p_draws=np.asarray([0.2, 0.5]),
                conditional_cdf_draws=np.asarray(
                    [
                        [0.0, 1.0],
                        [0.0, 0.5],
                    ]
                ),
            ),
            days=4,
        )

        self.assertEqual(len(ops), 2)
        self.assertAlmostEqual(ops[0].value[0, 1], 0.2)
        self.assertAlmostEqual(ops[1].value[0, 1], 0.25)

    def test_deterministic_draw_model_primitives_compile_shifted_delta(self) -> None:
        ops = deterministic_draw_model_primitive_operators(
            "A-B",
            p_draws=np.asarray([0.2, 0.5]),
            shift_days=2,
            days=5,
        )

        self.assertEqual(len(ops), 2)
        self.assertAlmostEqual(ops[0].value[0, 2], 0.2)
        self.assertAlmostEqual(ops[1].value[1, 3], 0.5)

    def test_operators_for_path_preserves_supplied_path_order(self) -> None:
        a = nonlatent_model_primitive_operator("A-B", p=0.5, days=3)
        b = nonlatent_model_primitive_operator("B-C", p=0.25, days=3)

        ops = operators_for_path(
            ("A-B", "B-C"),
            {"B-C": b, "A-B": a},
        )

        self.assertEqual(tuple(op.name for op in ops), ("A-B", "B-C"))


if __name__ == "__main__":
    unittest.main()

